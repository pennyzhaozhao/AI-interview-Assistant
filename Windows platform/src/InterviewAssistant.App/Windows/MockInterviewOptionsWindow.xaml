<Window x:Class="InterviewAssistant.Windows.MockInterviewOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" Height="350" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="28">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="模拟面试设置" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Width="38" Height="38" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <TextBlock x:Name="DescriptionText" Text="选择这次模拟面试要包含多少道题。" Style="{StaticResource CaptionStyle}" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Content="−" Width="48" Click="Decrease_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBox x:Name="CountBox" Text="6" Width="92" Height="52" Margin="12,0" Padding="0"
                             FontSize="24" FontWeight="SemiBold" TextAlignment="Center" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             PreviewTextInput="CountBox_PreviewTextInput" TextChanged="CountBox_TextChanged" PreviewKeyDown="CountBox_PreviewKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Button Content="+" Width="48" Click="Increase_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBlock x:Name="UnitText" Text="题" FontSize="17" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="RangeText" Text="3–10" Style="{StaticResource CaptionStyle}" Margin="62,10,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2"><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><Button x:Name="StartButton" Content="▶  开始模拟面试" Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Border>
</Window>
