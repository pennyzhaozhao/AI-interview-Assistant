<UserControl x:Class="InterviewAssistant.Views.DirectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:InterviewAssistant.Infrastructure"
             xmlns:loc="clr-namespace:InterviewAssistant.Services"
             Loaded="DirectorView_Loaded"
             Background="{DynamicResource DirectorBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="DirectorPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="22,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DirectorSecondary" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DirectorTextBrush}"/><Setter Property="Background" Value="{DynamicResource DirectorBorderBrush}"/>
        </Style>
        <Style x:Key="DirectorField" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Background" Value="{DynamicResource DirectorFieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource DirectorTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DirectorBorderBrush}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" infra:SmoothScrollBehavior.IsEnabled="True">
        <StackPanel Margin="32" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,26">
                <StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource DirectorTextBrush}" FontSize="48" FontWeight="Bold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="16" Margin="0,7,0,0"/></StackPanel>
                <Button Content="{loc:Loc Key=Start}" Command="{Binding OpenHostBoardCommand}" Style="{StaticResource DirectorPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource DirectorPanelBrush}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key='YOUR IP ADDRESS'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <Border Background="{DynamicResource DirectorFieldBrush}" CornerRadius="10" Padding="16" Margin="0,14"><TextBlock Text="{Binding LocalIp}" Foreground="{DynamicResource DirectorTextBrush}" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="{loc:Loc Key='ENTER HOST IP ADDRESS'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding HostIp, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DirectorField}" FontFamily="Consolas" FontSize="17"/><Button Grid.Column="2" Content="{loc:Loc Key=Connect}" Command="{Binding ConnectCommand}" Style="{StaticResource DirectorPrimary}"/></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource DirectorTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource DirectorPanelBrush}" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key='WEB CONTROLLER'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" FontWeight="Bold"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="142" Height="142" Background="White" Padding="8"><Image Source="{Binding ControllerQrCode}" Stretch="Uniform"/></Border>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Key='Scan to send without the app'}" Foreground="{DynamicResource DirectorTextBrush}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Foreground="{DynamicResource DirectorMutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,10,0,0"><Run Text="http://"/><Run Text="{Binding LocalIp, Mode=OneWay}"/><Run Text=":9999"/></TextBlock>
                                <TextBlock Text="{loc:Loc Key='The Host prompt board must be running on the same Wi-Fi.'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc Key='Controller address QR'}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{DynamicResource DirectorPanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid><TextBlock Text="{loc:Loc Key='QUESTION'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" FontWeight="Bold"/><StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="&#xE7F4;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource DangerBrush}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc Key='Host prompt board status'}" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="Bold"/></StackPanel><TextBlock Text="{Binding ModeStatusText}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel></Grid>
                    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions><Button Command="{Binding PreviousQuestionCommand}" Style="{StaticResource DirectorSecondary}" Width="48" Height="48" Padding="0" BorderThickness="1"><TextBlock Text="&#xE76B;" Style="{StaticResource FluentIconStyle}"/></Button><TextBlock Grid.Column="1" Text="{Binding SelectedQuestion.Text}" Foreground="{DynamicResource DirectorTextBrush}" FontSize="25" FontWeight="Medium" MinHeight="110" VerticalAlignment="Center" Margin="18,0" TextWrapping="Wrap"/><Button Grid.Column="2" Command="{Binding NextQuestionCommand}" Style="{StaticResource DirectorSecondary}" Width="48" Height="48" Padding="0"><TextBlock Text="&#xE76C;" Style="{StaticResource FluentIconStyle}"/></Button></Grid>
                    <TextBlock Text="{loc:Loc Key='Waiting for the Host to hear or capture a question'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource DirectorPanelBrush}" CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key='SEND MARKDOWN CONTENT'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" FontWeight="Bold"/>
                    <TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DirectorField}" Height="170" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" FontFamily="Consolas" Margin="0,14,0,0"/>
                    <Grid Margin="0,14,0,0"><TextBlock Text="{loc:Loc Key='Supports headings, lists, code blocks and links'}" Foreground="{DynamicResource DirectorMutedBrush}" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Loc Key=Clear}" Command="{Binding ClearCommand}" Style="{StaticResource DirectorSecondary}"/><Button Content="{loc:Loc Key=Send}" Command="{Binding SendCommand}" Style="{StaticResource DirectorPrimary}" Margin="10,0,0,0"/></StackPanel></Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
