<Window x:Class="InterviewAssistant.Windows.MockInterviewOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" Height="350" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, SimSun, Segoe UI" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- Square icon-style button: no horizontal padding so the glyph is never clipped. -->
        <Style x:Key="StepperButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="28">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="模拟面试设置" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,52,0"/>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center" Width="38" Height="38" Padding="0" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" TextWrapping="NoWrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <TextBlock x:Name="DescriptionText" Text="选择这次模拟面试要包含多少道题。" Style="{StaticResource CaptionStyle}" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button Content="−" Click="Decrease_Click" Style="{StaticResource StepperButtonStyle}"/>
                    <!-- The rounded box is drawn by the Border; the TextBox inside keeps WPF's stock template
                         so its text host is always laid out and visible. -->
                    <Border x:Name="CountFrame" Width="92" Height="52" Margin="12,0" CornerRadius="15"
                            Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox x:Name="CountBox" Text="6" MaxLength="2"
                                 FontSize="22" FontWeight="SemiBold" TextAlignment="Center"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Padding="0" Margin="6,0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="{DynamicResource PrimaryBrush}"
                                 InputMethod.IsInputMethodEnabled="False"
                                 GotKeyboardFocus="CountBox_GotKeyboardFocus" LostKeyboardFocus="CountBox_LostKeyboardFocus"
                                 PreviewTextInput="CountBox_PreviewTextInput" TextChanged="CountBox_TextChanged" PreviewKeyDown="CountBox_PreviewKeyDown"
                                 DataObject.Pasting="CountBox_Pasting"/>
                    </Border>
                    <Button Content="+" Click="Increase_Click" Style="{StaticResource StepperButtonStyle}"/>
                    <TextBlock x:Name="UnitText" Text="题" FontSize="17" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="RangeText" Text="3–10" Style="{StaticResource CaptionStyle}" Margin="62,10,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2"><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><Button x:Name="StartButton" Content="▶  开始模拟面试" Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid>
        </Grid>
    </Border>
</Window>
