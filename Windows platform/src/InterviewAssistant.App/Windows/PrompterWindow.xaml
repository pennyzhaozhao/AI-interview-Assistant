<Window x:Class="InterviewAssistant.Windows.PrompterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InterviewAssistant.Services"
        Width="600" Height="240" MinWidth="80" MinHeight="37"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="IslandPrimary" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="IslandSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="IslandYellow" Color="#FFF200"/>
        <SolidColorBrush x:Key="IslandGreen" Color="#35D07F"/>
        <SolidColorBrush x:Key="IslandBlue" Color="#7076FF"/>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource IslandSecondary}"/><Setter Property="Background" Value="#1FFFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.62"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.25"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IslandMenuButton" TargetType="Button" BasedOn="{StaticResource IslandButton}"><Setter Property="Height" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="Transparent"/></Style>
        <Style x:Key="IslandIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ExpandedIsland" Background="#E8000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="20">
            <Grid Margin="16,8,16,0">
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="48"/><RowDefinition Height="8"/></Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="QuestionText" Text="Waiting for interview question..." Foreground="{StaticResource IslandSecondary}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="Wave1" Width="3" Height="5" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/><Border x:Name="Wave2" Width="3" Height="11" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/><Border x:Name="Wave3" Width="3" Height="17" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/><Border x:Name="Wave4" Width="3" Height="9" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/><Border x:Name="Wave5" Width="3" Height="14" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/><Border x:Name="Wave6" Width="3" Height="6" CornerRadius="2" Background="{StaticResource IslandYellow}" Margin="2,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" Width="30" Height="30" Background="#14FFFFFF" Click="PreviousButton_Click" IsEnabled="False" VerticalAlignment="Center"><TextBlock Text="&#xE76B;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/></Button>
                    <Grid Grid.Column="1" Margin="8,5"><ScrollViewer x:Name="AnswerScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="AnswerText" Text="Waiting for AI answer..." Foreground="{StaticResource IslandSecondary}" FontSize="24" FontWeight="SemiBold" LineHeight="33" TextWrapping="Wrap"/></ScrollViewer><StackPanel x:Name="PreparingPanel" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed"><TextBlock Text="&#xE895;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/><TextBlock x:Name="PreparingText" Text="Preparing answer suggestion..." Foreground="{StaticResource IslandSecondary}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel></Grid>
                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource IslandButton}" Width="30" Height="30" Background="#14FFFFFF" Click="NextButton_Click" IsEnabled="False" VerticalAlignment="Center"><TextBlock Text="&#xE76C;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/></Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,5,0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IslandButton}" Width="36" Height="34" Click="ScreenshotButton_Click" ToolTip="Screenshot"><TextBlock Text="&#xE722;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/></Button>
                    <StackPanel x:Name="AiOnlyTools" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CodeButton" Style="{StaticResource IslandButton}" Height="34" Margin="7,0,0,0" Padding="11,0" Click="CodeButton_Click" ToolTip="Code language"><StackPanel Orientation="Horizontal"><TextBlock Text="&lt;/&gt;" Foreground="{StaticResource IslandYellow}" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="CodeLanguageText" Text="python" Foreground="{StaticResource IslandYellow}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                    <Button x:Name="AudioButton" Grid.Column="2" Style="{StaticResource IslandButton}" Width="36" Height="34" Margin="7,0,0,0" Click="AudioButton_Click" ToolTip="Audio source"><TextBlock x:Name="AudioIcon" Text="&#xE720;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/></Button>
                    <Button x:Name="AiKnowledgeButton" Grid.Column="3" Style="{StaticResource IslandButton}" Height="34" Margin="7,0,0,0" Padding="10,0" Click="KnowledgeButton_Click" ToolTip="Knowledge base"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/><TextBlock x:Name="KnowledgeCountText" Text="0" Foreground="{StaticResource IslandPrimary}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ModeButton" Grid.Column="4" Style="{StaticResource IslandButton}" Width="36" Height="34" Margin="7,0,0,0" Click="ModeButton_Click" ToolTip="Switch to Director mode"><TextBlock Text="&#xE72C;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandYellow}"/></Button>
                    <Button Grid.Column="6" Style="{StaticResource IslandButton}" Width="36" Height="34" Click="MinimizeButton_Click" ToolTip="Minimize prompter">
                        <Viewbox Width="12" Height="12"><Canvas Width="10" Height="10"><Path Fill="#E9E9E9" Data="M8.33333,0 H1.66667 C1.2248,0.000529 0.801186,0.176294 0.48874,0.48874 C0.176294,0.801186 0.000529,1.2248 0,1.66667 V8.33333 C0.000529,8.7752 0.176294,9.19881 0.48874,9.51126 C0.801186,9.82371 1.2248,9.99947 1.66667,10 H8.33333 C8.7752,9.99947 9.19881,9.82371 9.51126,9.51126 C9.82371,9.19881 9.99947,8.7752 10,8.33333 V1.66667 C9.99947,1.2248 9.82371,0.801186 9.51126,0.48874 C9.19881,0.176294 8.7752,0.000529 8.33333,0 Z M9.33333,8.33333 C9.33298,8.59844 9.22751,8.85259 9.04005,9.04005 C8.85259,9.22751 8.59844,9.33298 8.33333,9.33333 H1.66667 C1.40156,9.33298 1.14741,9.22751 0.95995,9.04005 C0.77249,8.85259 0.667019,8.59844 0.666667,8.33333 V1.66667 C0.667019,1.40156 0.77249,1.14741 0.95995,0.95995 C1.14741,0.77249 1.40156,0.667019 1.66667,0.666667 H8.33333 C8.59844,0.667019 8.85259,0.77249 9.04005,0.95995 C9.22751,1.14741 9.33298,1.40156 9.33333,1.66667 Z"/><Path Fill="#E9E9E9" Data="M4.45994,5.35934 C4.41983,5.34247 4.37679,5.33363 4.33327,5.33334 H2.99994 C2.91154,5.33334 2.82675,5.36845 2.76424,5.43097 C2.70173,5.49348 2.66661,5.57826 2.66661,5.66667 C2.66661,5.75507 2.70173,5.83986 2.76424,5.90237 C2.82675,5.96488 2.91154,6 2.99994,6 H3.52861 L2.09727,7.43067 C2.03477,7.49326 1.99969,7.57812 1.99976,7.66657 C1.99982,7.75503 2.03502,7.83983 2.09761,7.90234 C2.1602,7.96484 2.24506,7.99992 2.33351,7.99985 C2.42196,7.99979 2.50677,7.96459 2.56927,7.902 L3.99994,6.47134 V7 C3.99994,7.08841 4.03506,7.17319 4.09757,7.2357 C4.16008,7.29822 4.24487,7.33334 4.33327,7.33334 C4.42168,7.33334 4.50647,7.29822 4.56898,7.2357 C4.63149,7.17319 4.66661,7.08841 4.66661,7 V5.66667 C4.66637,5.60067 4.64662,5.53622 4.60985,5.48142 C4.57307,5.42662 4.52092,5.38391 4.45994,5.35867 Z M7.43061,2.098 L5.99994,3.52867 V3 C5.99994,2.9116 5.96482,2.82681 5.90231,2.7643 C5.8398,2.70179 5.75501,2.66667 5.66661,2.66667 C5.5782,2.66667 5.49342,2.70179 5.43091,2.7643 C5.36839,2.82681 5.33327,2.9116 5.33327,3 V4.33334 C5.33363,4.42163 5.36886,4.50621 5.43129,4.56865 C5.49373,4.63109 5.57831,4.66632 5.66661,4.66667 H6.99994 C7.08835,4.66667 7.17313,4.63155 7.23564,4.56904 C7.29816,4.50653 7.33328,4.42174 7.33328,4.33334 C7.33328,4.24493 7.29816,4.16015 7.23564,4.09763 C7.17313,4.03512 7.08835,4 6.99994,4 H6.47127 L7.90261,2.56867 C7.93565,2.53821 7.96219,2.50139 7.98064,2.46042 C7.99909,2.41944 8.00906,2.37516 8.00996,2.33024 C8.01086,2.28531 8.00267,2.24066 7.98587,2.0877 C7.88043,2.05595 7.84255,2.03095 7.80084,2.01422 C7.75914,1.99748 7.71448,1.98935 7.66956,1.99031 C7.62463,1.99127 7.58036,2.00131 7.53942,2.01982 C7.49847,2.03832 7.46168,2.06492 7.43061,2.098 Z"/></Canvas></Viewbox>
                    </Button>
                    <Button Grid.Column="7" Style="{StaticResource IslandButton}" Width="36" Height="34" Margin="7,0,0,0" Click="CloseButton_Click" ToolTip="End interview"><TextBlock Text="&#xE711;" Style="{StaticResource IslandIcon}" Foreground="{StaticResource IslandPrimary}" FontSize="18"/></Button>
                </Grid>
                <Border Grid.Row="3" Width="44" Height="4" CornerRadius="2" Background="#7AFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="SizeNS" MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown" MouseMove="ResizeHandle_MouseMove" MouseLeftButtonUp="ResizeHandle_MouseLeftButtonUp"/>
            </Grid>
        </Border>

        <Button x:Name="CompactIsland" Visibility="Collapsed" Style="{StaticResource IslandButton}" Background="Transparent" Width="42" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top" Click="RestoreButton_Click" ToolTip="Restore prompter">
            <Viewbox Width="20" Height="20"><Canvas Width="1024" Height="1024"><Path Fill="#D9D9D9" Data="M195.8656,831.93856 C21.2736,657.34656 21.2736,373.69856 195.8656,199.10144 C370.4576,24.50944 654.1056,24.50944 828.70272,199.10144 C1003.29472,373.69344 1003.29984,657.34656 828.70272,831.93856 C654.1056,1006.53056 370.45248,1006.53056 195.8656,831.93856 Z M769.3056,258.49856 C627.4816,116.67456 397.0816,116.67456 255.2576,258.49856 C113.4336,400.32256 113.4336,630.7328 255.2576,772.55168 C397.0816,914.37056 627.4816,914.37056 769.3056,772.55168 C911.1296,630.72256 911.1296,400.32256 769.3056,258.49856 Z"/><Path Fill="#D9D9D9" Data="M755.3024,410.02496 A41.59488,41.59488 0 0 0 696.4736,410.02496 L512.28672,594.21184 L328.09984,410.02496 A41.60512,41.60512 0 0 0 269.26592,468.85888 L482.816,682.40384 L482.86208,682.45504 A41.43616,41.43616 0 0 0 512.2816,694.64064 A41.4464,41.4464 0 0 0 541.70112,682.45504 L541.75232,682.40384 L755.3024,468.85888 A41.6256,41.6256 0 0 0 755.3024,410.02496 Z"/></Canvas></Viewbox>
        </Button>

        <Border x:Name="ModeToast" Visibility="Collapsed" Panel.ZIndex="30" Background="#E8D7D7D7" CornerRadius="18" Padding="16,8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="ModeToastText" Foreground="#172238" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <Popup x:Name="CodeLanguagePopup" PlacementTarget="{Binding ElementName=CodeButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="CodeLanguagePopup_Closed">
            <Border Background="#FCFFFFFF" BorderBrush="#4A000000" BorderThickness="1" CornerRadius="18" Padding="14">
                <StackPanel Width="272">
                    <TextBlock Text="{loc:Loc Key=Choose code language}" Foreground="#6F7F98" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="CodeLanguageInput" Width="174" Height="34" Text="python" FontSize="14" Foreground="#152138" Background="#FFF" BorderBrush="#D5D9E0" BorderThickness="1" Padding="10,5" VerticalContentAlignment="Center" KeyDown="CodeLanguageInput_KeyDown"/>
                        <Button Content="{loc:Loc Key=Save}" Width="76" Height="34" Margin="10,0,0,0" Foreground="#152138" Background="#D3D4D8" BorderThickness="0" Click="CodeLanguageSave_Click"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="python" Tag="python" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/><Button Content="cpp" Tag="cpp" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/><Button Content="java" Tag="java" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/><Button Content="swift" Tag="swift" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/><Button Content="javascript" Tag="javascript" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/><Button Content="go" Tag="go" Margin="0,0,6,6" Padding="12,6" Click="CodeLanguage_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
