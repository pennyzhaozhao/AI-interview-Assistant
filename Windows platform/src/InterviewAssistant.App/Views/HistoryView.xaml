<?xml version="1.0"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:InterviewAssistant.Infrastructure" xmlns:loc="clr-namespace:InterviewAssistant.Services" x:Class="InterviewAssistant.Views.HistoryView">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="46*"/>
      <ColumnDefinition Width="1"/>
      <ColumnDefinition Width="54*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="32,28,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionStyle}" FontSize="16" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,0">
        <TextBlock Text="{loc:Loc Key=History Type}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Content="{loc:Loc Key=Formal Interview}" Command="{Binding SetKindCommand}" CommandParameter="formal" Padding="14,0" Height="34">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedKind}" Value="formal">
                  <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                  <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="{loc:Loc Key=Mock Interview}" Command="{Binding SetKindCommand}" CommandParameter="mock" Padding="14,0" Height="34" Margin="4,0,0,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedKind}" Value="mock">
                  <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                  <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Padding="42,11,14,11"/>
        <TextBlock Text="&#xE721;" Style="{StaticResource FluentIconStyle}" FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,18">
        <Button Command="{Binding ToggleSelectionModeCommand}" Style="{StaticResource SecondaryButtonStyle}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" Style="{StaticResource FluentIconStyle}" FontSize="15" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding SelectionButtonText}"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding SelectAllCommand}" Content="{loc:Loc Key=Select All}" Margin="10,0,0,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Command="{Binding DeleteSelectedCommand}" Content="{loc:Loc Key=Delete Selected}" Foreground="{DynamicResource DangerBrush}" Margin="10,0,0,0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
      <ListBox Grid.Row="4" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Root" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsBulkSelected}" Margin="0,0,10,0" VerticalAlignment="Center">
                  <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource CircleSelectionCheckBoxStyle}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </CheckBox.Style>
                </CheckBox>
                <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border Grid.Column="2" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="8,4">
                  <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding StartedAtText}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0"/>
              <TextBlock Text="{Binding QuestionCountText}" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
    <Grid Grid.Column="2" Margin="32,28,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="18"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="{loc:Loc Key=Conversation}" Style="{StaticResource SectionTitleStyle}" FontSize="28"/>
        <TextBlock Text="{loc:Loc Key=Select a session to inspect the interview flow.}" Style="{StaticResource CaptionStyle}" FontSize="15" Margin="0,6,0,0"/>
      </StackPanel>
      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE8BD;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="38"/>
            <TextBlock Text="{loc:Loc Key=No interview history yet.}" Style="{StaticResource CaptionStyle}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" infra:SmoothScrollBehavior.IsEnabled="True">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <StackPanel DataContext="{Binding SelectedSession}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- macOS: Export Evaluation PDF (mock interviews only). -->
                <Button Grid.Column="1" Click="ExportPdf_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button.Visibility><Binding Path="IsMock" Converter="{StaticResource BoolToVisibility}"/></Button.Visibility>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIconStyle}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="{loc:Loc Key='Export Evaluation PDF'}" VerticalAlignment="Center"/></StackPanel>
                </Button>
              </Grid>
              <!-- macOS: editable conversation title. -->
              <TextBlock Text="{loc:Loc Key='Conversation title'}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="2,14,0,7"/>
              <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Tag="{loc:Loc Key='Add a clear review title'}"/>
              <StackPanel Orientation="Horizontal" Margin="0,7,0,20">
                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="  &#xB7;  "/>
                <TextBlock Text="{Binding StartedAtText}" Style="{StaticResource CaptionStyle}"/>
              </StackPanel>
              <Border Background="{DynamicResource InputBrush}" CornerRadius="15" Padding="16" Margin="0,0,0,18">
                <StackPanel>
                  <TextBlock Text="{loc:Loc Key=Summary}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="15" Padding="16" Margin="0,0,0,18">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMock}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{Binding ScoreText}" Foreground="{DynamicResource PrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                  <TextBlock Text="{loc:Loc Key=Strengths}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBlock Text="{Binding StrengthsText}" TextWrapping="Wrap"/>
                  <TextBlock Text="{loc:Loc Key=Improvement Suggestions}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBlock Text="{Binding ImprovementsText}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Turns}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="{loc:Loc Key='QUESTION'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Question}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                        <!-- Screenshot captured for this question; double-click to view full size. -->
                        <Border CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,14" HorizontalAlignment="Left" MaxWidth="460" Cursor="Hand" ClipToBounds="True"
                                MouseLeftButtonDown="Screenshot_MouseLeftButtonDown" ToolTip="{loc:Loc Key='Double-click to view image'}">
                          <Border.Visibility><Binding Path="HasScreenshot" Converter="{StaticResource BoolToVisibility}"/></Border.Visibility>
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="260"/>
                        </Border>
                        <TextBlock Text="{loc:Loc Key='ANSWER'}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Answer}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <!-- Scores / feedback only exist for mock interviews; formal interviews show Q&A only. -->
                        <TextBlock Text="{Binding Score, StringFormat={}{0}/100}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,14,0,0">
                          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Score}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Feedback}" Margin="0,6,0,0" TextWrapping="Wrap">
                          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Feedback}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding SuggestedAnswer}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                          <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SuggestedAnswer}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
