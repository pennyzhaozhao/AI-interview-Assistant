<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\InterviewAssistant.ico</ApplicationIcon>
    <AssemblyName>InterviewAssistant</AssemblyName>
    <RootNamespace>InterviewAssistant</RootNamespace>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InterviewAssistant.Rag\InterviewAssistant.Rag.csproj" />
  </ItemGroup>
  <!-- Local RAG model (fetched by scripts/fetch-rag-model.*; not in git because of its size). Shipped next to the app. -->
  <ItemGroup Condition="Exists('..\..\..\LocalRAG\model\model_quantized.onnx')">
    <Content Include="..\..\..\LocalRAG\model\*.*" Link="LocalRAG\model\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Resource Include="Assets\*.svg" />
    <Resource Include="Assets\AppLogo.png" />
    <Resource Include="Assets\InterviewAssistant.ico" />
  </ItemGroup>
  <!--
    sherpa-onnx (speaker verification) and Microsoft.ML.OnnxRuntime (local RAG embeddings) both ship onnxruntime.dll.
    Keep exactly one copy — Microsoft's official build of the same 1.28 line — so both features load the same runtime
    and publishing does not fail on duplicate files (NETSDK1152).
  -->
  <Target Name="SingleOnnxRuntime" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('org.k2fsa.sherpa.onnx.runtime')) And '%(Filename)%(Extension)' == 'onnxruntime.dll'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('org.k2fsa.sherpa.onnx.runtime')) And '%(Filename)%(Extension)' == 'onnxruntime.dll'" />
    </ItemGroup>
  </Target>
</Project>
