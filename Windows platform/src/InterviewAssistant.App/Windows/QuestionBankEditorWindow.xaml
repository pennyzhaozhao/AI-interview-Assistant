<Window x:Class="InterviewAssistant.Windows.QuestionBankEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="980" Height="820" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="10" Opacity="0.28"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel><TextBlock Text="{DynamicResource QuestionBankEditorTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource QuestionBankEditorHint}" Style="{StaticResource CaptionStyle}" Margin="0,5,50,0" TextWrapping="Wrap"/></StackPanel>
                <Button Content="×" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource WindowButtonStyle}" Click="Cancel_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,22,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" Style="{StaticResource InputStyle}"/>
                <Button Grid.Column="2" Content="{DynamicResource BatchImportText}" Style="{StaticResource SecondaryButtonStyle}" Click="BatchImport_Click"/>
                <Button Grid.Column="4" Content="{DynamicResource UploadQuestionFileText}" Style="{StaticResource SecondaryButtonStyle}" Click="Upload_Click"/>
                <Button Grid.Column="6" Content="{DynamicResource AddPrimaryQuestionText}" Style="{StaticResource PrimaryButtonStyle}" Click="AddPrimary_Click"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <!-- Outline: questions with their follow-ups (foldable); clicking scrolls to the card. -->
                <Border x:Name="OutlineBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="8,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource OutlineText}" Style="{StaticResource CaptionStyle}" Margin="10,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OutlinePanel"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="QuestionScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="QuestionPanel"/></ScrollViewer>
                <StackPanel x:Name="EmptyPanel" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="?" FontSize="42" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource NoQuestionsText}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource NoQuestionsHint}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,220,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource CancelText}" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/><Button Content="{DynamicResource SaveText}" Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0" Click="Save_Click"/></StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
