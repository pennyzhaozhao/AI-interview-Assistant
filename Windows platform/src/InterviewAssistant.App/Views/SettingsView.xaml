<UserControl x:Class="InterviewAssistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:InterviewAssistant.Infrastructure"
             xmlns:loc="clr-namespace:InterviewAssistant.Services"
             Loaded="SettingsView_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" infra:SmoothScrollBehavior.IsEnabled="True">
        <Grid Margin="28,24,28,40" HorizontalAlignment="Stretch">
            <StackPanel x:Name="SettingsRootPanel">
                <TextBlock Text="{loc:Loc Key=APPEARANCE}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="6,0,0,10"/>
                <Border Style="{StaticResource CardStyle}" Padding="16,14">
                    <StackPanel>
                        <Grid MinHeight="70">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE774;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=Language}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Style="{StaticResource ComboBoxStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                        <Grid MinHeight="78">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE708;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource WarningBrush}"/></Border>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Key=Mode}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Click="ToggleTheme_Click" Width="122" Height="51" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Button.Template>
                                <Grid x:Name="ThemeToggleHost">
                                    <Border x:Name="ThemeToggleTrack" Width="122" Height="46" CornerRadius="23" Background="#0F0000" VerticalAlignment="Top">
                                        <Grid>
                                            <Grid x:Name="ThemeToggleThumb" Width="43" Height="40" HorizontalAlignment="Left" Margin="2,0,0,0">
                                                <Grid.RenderTransform><TranslateTransform x:Name="ThemeToggleTranslate"/></Grid.RenderTransform>
                                                <Ellipse Fill="White"/>
                                                <TextBlock x:Name="ThemeToggleIcon" Text="&#xE708;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#060625" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc Key=DATA STORAGE}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="6,6,0,10"/>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Key=Storage Location}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key=StorageDescription}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/><TextBlock Text="{Binding DataDirectory}" FontFamily="Consolas" FontSize="13" Margin="0,7,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Content="{loc:Loc Key=Choose folder}" Click="ChooseDataFolder_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button Content="{loc:Loc Key=Open folder}" Click="OpenDataFolder_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/></StackPanel><Button Content="{loc:Loc Key=Clear all data}" Click="ClearLocalData_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Text="{loc:Loc Key=Changing the location copies your existing data safely. Restart the app once to begin using the new folder.}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="AI" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="6,6,0,10"/>
                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE716;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key=Mock Interviewer Language}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding SpeechLanguages}" SelectedItem="{Binding MockInterviewLanguage}" Style="{StaticResource ComboBoxStyle}" VerticalAlignment="Center"/></Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE720;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key=Interviewer Speech Language}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="2" ItemsSource="{Binding SpeechLanguages}" SelectedItem="{Binding InterviewerLanguage}" Style="{StaticResource ComboBoxStyle}" VerticalAlignment="Center"/></Grid>
                </Border>
                <Button Click="OpenApiConfig_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" Style="{StaticResource FluentIconStyle}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="{loc:Loc Key=API Configure}"/></StackPanel></Button>

                <Border Style="{StaticResource CardStyle}" Padding="16,10">
                    <Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE7B8;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key=Screenshot OCR}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding ScreenshotHotkey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" VerticalAlignment="Center"/></Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource WarningSoftBrush}" HorizontalAlignment="Left"><TextBlock Text="&#xE722;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource WarningBrush}"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc Key=Screenshot Mode}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key=ScreenshotModeDescription}" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,6"><TextBlock Text="&#xE73E;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource SuccessBrush}" FontSize="15" Margin="0,0,8,0"/><TextBlock Text="{Binding ScreenshotPermissionStatus}" Foreground="{DynamicResource SuccessBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        <RadioButton GroupName="ScreenshotMode" IsChecked="{Binding IsPresetRegion}" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel Margin="8,0,0,0"><TextBlock Text="{loc:Loc Key=Preset Region Screenshot}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key=PresetRegionDescription}" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ScreenshotMode" IsChecked="{Binding IsManualRegion}" Margin="0,16,0,0" Foreground="{DynamicResource TextPrimaryBrush}">
                            <StackPanel Margin="8,0,0,0"><TextBlock Text="{loc:Loc Key=Manual Selection Screenshot}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key=ManualRegionDescription}" Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                        </RadioButton>
                        <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPresetRegion}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel>
                                <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontSize="15" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FluentIconStyle}"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasScreenshotRegion}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ScreenshotRegionStatus}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding ScreenshotRegionActionText}" Click="SetScreenshotRegion_Click" Style="{StaticResource SecondaryButtonStyle}" Height="38"/><Button Content="{loc:Loc Key=Clear}" Click="ClearScreenshotRegion_Click" Height="38" Margin="8,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasScreenshotRegion}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid>
                                <TextBlock Text="{loc:Loc Key=RegionSetupHint}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel><Grid><TextBlock Text="{loc:Loc Key=Hide prompter during screen sharing}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding HidePrompterFromCapture}" Style="{StaticResource SwitchCheckBoxStyle}" HorizontalAlignment="Right"/></Grid><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/><Grid><TextBlock Text="{loc:Loc Key=Hide Interview AI from the taskbar during interviews}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox IsChecked="{Binding HideTaskbarIconDuringInterview}" Style="{StaticResource SwitchCheckBoxStyle}" HorizontalAlignment="Right"/></Grid></StackPanel>
                </Border>

                <TextBlock Text="{loc:Loc Key='SPEAKER RECOGNITION'}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="6,6,0,10"/>
                <Border Style="{StaticResource CardStyle}" Padding="16,10"><Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE720;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key=Set Up Voices}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="12,0"/></Grid></Border>

                <TextBlock Text="{loc:Loc Key=ABOUT}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="6,6,0,10"/>
                <Border Style="{StaticResource CardStyle}" Padding="16,10" Cursor="Hand" MouseLeftButtonUp="ShowAbout_Click"><Grid MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource ButtonBrush}"><TextBlock Text="&#xE946;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{loc:Loc Key=About}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc Key=AboutDescription}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="12,0"/></Grid></Border>
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Margin="6,0,0,16"/>
            </StackPanel>

            <StackPanel x:Name="ApiConfigPanel" Visibility="Collapsed">
                <Button Click="BackToSettings_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource FluentIconStyle}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc Key=Settings}" FontSize="16"/></StackPanel></Button>
                <TextBlock Text="{loc:Loc Key='API Configuration'}" Style="{StaticResource PageTitleStyle}" FontSize="34"/>
                <TextBlock Text="{loc:Loc Key='Configure speech recognition and the LLM separately. Credentials stay on this device, and requests go directly to the selected provider.'}" Style="{StaticResource CaptionStyle}" FontSize="15" TextWrapping="Wrap" Margin="0,6,0,24"/>

                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key='Speech Recognition'}" Style="{StaticResource SectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="{loc:Loc Key='Used to transcribe the interviewer in real time. Volcano requires an App ID and Access Token; Windows on-device recognition requires no credentials.'}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,16"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,4">
                            <Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Key='Recognition Engine'}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding SpeechRecognitionEngines}" SelectedItem="{Binding SpeechRecognitionEngine}" Style="{StaticResource ComboBoxStyle}"/></Grid>
                        </Border>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,16"/>
                        <TextBlock Text="App ID" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="2,0,0,7"/><TextBox Text="{Binding SpeechAppId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/>
                        <TextBlock Text="Access Token" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="2,14,0,7"/><PasswordBox x:Name="SpeechTokenBox" PasswordChanged="SpeechTokenBox_PasswordChanged" Style="{StaticResource PasswordInputStyle}"/>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,4" Margin="0,16,0,0">
                            <Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Key='Recognition Model'}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding SpeechResourceIds}" SelectedItem="{Binding SpeechResourceId}" Style="{StaticResource ComboBoxStyle}"/></Grid>
                        </Border>
                        <TextBlock Text="{loc:Loc Key='The 2.0 hourly plan is recommended. Create an app in the Volcano console and enable the matching model.'}" Style="{StaticResource CaptionStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <Grid Margin="0,18,0,0"><Button Content="{loc:Loc Key='Test Connection'}" Command="{Binding TestSpeechConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><Button Content="{loc:Loc Key='Save'}" Command="{Binding SaveSpeechCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid>
                        <TextBlock Text="{Binding SpeechStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="2,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key='Provider'}" Style="{StaticResource SectionTitleStyle}" FontSize="19"/><TextBlock Text="{loc:Loc Key='Select where responses should be generated.'}" Style="{StaticResource CaptionStyle}" Margin="0,5,0,16"/>
                        <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" BorderThickness="0" Background="{DynamicResource InputBrush}" Padding="5">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" HorizontalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Tab" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel><TextBlock Text="{loc:Loc Key=Model}" Style="{StaticResource SectionTitleStyle}" FontSize="19"/><TextBlock Text="{loc:Loc Key='Choose a supported model or enter a custom model identifier.'}" Style="{StaticResource CaptionStyle}" Margin="0,5,0,16"/><Border Background="{DynamicResource InputBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,4"><Grid MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc Key='Current model'}" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" IsEditable="True" Style="{StaticResource ComboBoxStyle}"/></Grid></Border></StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel><TextBlock Text="{loc:Loc Key=Connection}" Style="{StaticResource SectionTitleStyle}" FontSize="19"/><TextBlock Text="{loc:Loc Key='The API key is kept in Windows Credential Manager and is sent only to the selected provider.'}" Style="{StaticResource CaptionStyle}" Margin="0,5,0,16"/><TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" Style="{StaticResource PasswordInputStyle}" Margin="0,12,0,0"/><Grid Margin="0,18,0,0"><Button Content="{loc:Loc Key='Test Connection'}" Command="{Binding TestConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/><Button Content="{loc:Loc Key=Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Status}" Style="{StaticResource CaptionStyle}" Margin="0,12,0,0"/></StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AboutPanel" Visibility="Collapsed" MaxWidth="920" HorizontalAlignment="Stretch">
                <Button Click="BackFromAbout_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource FluentIconStyle}" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc Key=Settings}" FontSize="16"/></StackPanel>
                </Button>

                <Border Style="{StaticResource CardStyle}" Padding="28" CornerRadius="24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Interview AI" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="{loc:Loc Key='Your calm interview copilot.'}" Style="{StaticResource CaptionStyle}" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="22" CornerRadius="20">
                    <StackPanel>
                        <Grid Margin="0,2"><TextBlock Text="{loc:Loc Key=Version}" Style="{StaticResource CaptionStyle}"/><TextBlock x:Name="AboutVersionText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,12,0,0"><TextBlock Text="{loc:Loc Key=Build}" Style="{StaticResource CaptionStyle}"/><TextBlock x:Name="AboutBuildText" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,12,0,0"><TextBlock Text="{loc:Loc Key=Platform}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="Windows" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,12,0,2"><TextBlock Text="{loc:Loc Key=Storage}" Style="{StaticResource CaptionStyle}"/><TextBlock Text="{loc:Loc Key='Local only'}" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                    </StackPanel>
                </Border>

                <!-- Plain template: the shared button styles have a fixed 46px height and a centered
                     presenter, which clipped this card. -->
                <Button x:Name="CheckUpdatesButton" Click="CheckUpdates_Click" Cursor="Hand" Margin="0,0,0,18" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Focusable="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.9"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid MinHeight="52">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitleText" Text="{loc:Loc Key='Check for Updates...'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionStyle}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="2" Width="24" Margin="12,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateChevron" Text="&#xE76C;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <infra:ActivitySpinner x:Name="UpdateSpinner" Width="18" Height="18" SpokeThickness="1.8" SpokeBrush="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Button>

                <!-- Result card (macOS shows the same title / message / download in an alert). -->
                <Border x:Name="UpdateResultCard" Style="{StaticResource CardStyle}" Padding="20" CornerRadius="20" Visibility="Collapsed" Margin="0,-6,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateResultIcon" Text="&#xE930;" Style="{StaticResource FluentIconStyle}" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock x:Name="UpdateResultTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateResultMessage" Style="{StaticResource CaptionStyle}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIconStyle}" FontSize="15" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{loc:Loc Key='Download Update'}" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="18" CornerRadius="20">
                    <StackPanel>
                        <Grid MinHeight="54"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE72E;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key='Privacy Policy'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/></Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>
                        <Grid MinHeight="54"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}"><TextBlock Text="&#xE8A5;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource PrimaryBrush}"/></Border><TextBlock Grid.Column="1" Text="{loc:Loc Key='Terms of Service'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource FluentIconStyle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
